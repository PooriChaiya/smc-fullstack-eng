# Server environment — copy to .env and fill in values.
# Loaded automatically via `node --env-file-if-exists=.env` (see package.json).

# Database
DATABASE_URL="postgresql://app:dev@localhost:5432/smc"
DATABASE_READONLY_URL="postgresql://readonly_agent:readonly@localhost:5432/smc"

# Redis
REDIS_URL="redis://localhost:6379"

# Session
SESSION_TTL_SECONDS=86400

# OpenAI (required for LLM features)
OPENAI_API_KEY=

# Usage limits
USAGE_LIMIT_USD=1.00
USAGE_WINDOW_SECONDS=3600
